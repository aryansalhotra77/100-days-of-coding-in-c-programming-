#include <stdio.h>
int main()
{
    int num, i, count = 0;

    printf("Enter a number: ");
    scanf("%d", &num);

    if (num <= 1)
    {
        count = 1;
    }
    else
    {
        for (i = 2; i <= num / 2; i++)
        {
            if (num % i == 0)
            {
                count = 1;
                break;
            }
        }
    }

    if (count == 0)
    {
        printf("The number is Prime.");
    }
    else
    {
        printf("The number is not Prime.");
    }

    return 0;
}
