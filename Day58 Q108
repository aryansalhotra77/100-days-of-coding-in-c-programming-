#include <stdio.h>
int main()
{
    int nums[100], answer[100];
    int n, i, prefix = 1, suffix = 1;

    printf("Enter array size: ");
    scanf("%d", &n);

    printf("Enter array elements: ");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &nums[i]);
    }

    // Calculate products of elements on the left
    for (i = 0; i < n; i++)
    {
        answer[i] = prefix;
        prefix = prefix * nums[i];
    }

    // Multiply by products of elements on the right
    for (i = n - 1; i >= 0; i--)
    {
        answer[i] = answer[i] * suffix;
        suffix = suffix * nums[i];
    }

    printf("Product array: ");
    for (i = 0; i < n; i++)
    {
        printf("%d ", answer[i]);
    }

    return 0;
}
