#include <stdio.h>
int main()
{
    int arr[100], n, k;
    int i, sum = 0, maxSum;

    printf("Enter array size: ");
    scanf("%d", &n);

    printf("Enter array elements: ");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("Enter value of k: ");
    scanf("%d", &k);

    if (k <= 0 || k > n)
    {
        printf("Invalid value of k");
        return 0;
    }

    // Calculate sum of first k elements
    for (i = 0; i < k; i++)
    {
        sum = sum + arr[i];
    }

    maxSum = sum;

    // Slide the window
    for (i = k; i < n; i++)
    {
        sum = sum + arr[i] - arr[i - k];

        if (sum > maxSum)
        {
            maxSum = sum;
        }
    }

    printf("Maximum subarray sum = %d", maxSum);

    return 0;
}
