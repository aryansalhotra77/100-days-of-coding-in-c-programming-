#include <stdio.h>
#include <string.h>
int main()
{
    char s[1000];
    int i, j, start = 0;
    int maxLength = 0, length;
    int repeated;

    printf("Enter a string: ");
    scanf("%s", s);

    for (i = 0; s[i] != '\0'; i++)
    {
        repeated = 0;

        for (j = start; j < i; j++)
        {
            if (s[j] == s[i])
            {
                start = j + 1;
                repeated = 1;
                break;
            }
        }

        length = i - start + 1;

        if (length > maxLength)
        {
            maxLength = length;
        }
    }

    printf("Longest substring length = %d", maxLength);

    return 0;
}
