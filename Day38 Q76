#include <stdio.h>
int main()
{
    int a[10][10], n, i, j, flag = 1;

    printf("Enter the order of the matrix: ");
    scanf("%d", &n);

    printf("Enter the matrix elements:\n");

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    // Check whether the matrix is symmetric
    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            if (a[i][j] != a[j][i])
            {
                flag = 0;
                break;
            }
        }
    }

    if (flag == 1)
    {
        printf("The matrix is Symmetric.");
    }
    else
    {
        printf("The matrix is not Symmetric.");
    }

    return 0;
}
