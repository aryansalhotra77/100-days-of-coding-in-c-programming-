#include <stdio.h>
int main()
{
    int num, i, sum = 0;

    printf("Enter a number: ");
    scanf("%d", &num);

    for (i = 1; i <= num / 2; i++)
    {
        if (num % i == 0)
        {
            sum = sum + i;
        }
    }

    if (sum == num && num > 0)
    {
        printf("The number is a Perfect Number.");
    }
    else
    {
        printf("The number is not a Perfect Number.");
    }

    return 0;
}
