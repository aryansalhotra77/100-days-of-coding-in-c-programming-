#include <stdio.h>
int main()
{
    int arr[100], freq[101] = {0};
    int n, i;

    printf("Enter array size: ");
    scanf("%d", &n);

    printf("Enter array elements: ");

    for (i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);

        freq[arr[i]]++;

        if (freq[arr[i]] == 2)
        {
            printf("Repeated element = %d", arr[i]);
            return 0;
        }
    }

    return 0;
}
