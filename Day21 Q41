#include <stdio.h>
int main()
{
    int num, first, last, temp, digits = 0, power = 1;

    printf("Enter a number: ");
    scanf("%d", &num);

    temp = num;
    last = num % 10;

    while (temp >= 10)
    {
        temp = temp / 10;
        power = power * 10;
    }

    first = temp;

    num = num % power;
    num = num / 10;

    num = last * power + num * 10 + first;

    printf("Number after swapping = %d", num);

    return 0;
}
